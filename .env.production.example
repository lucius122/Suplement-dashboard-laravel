# =====================================================================
# Contoh .env untuk SERVER PRODUKSI (VPS). Salin jadi .env di server,
# lalu isi bagian yang bertanda GANTI. JANGAN pakai .env lokal.
#
#   cp .env.production.example .env
#   php artisan key:generate
# =====================================================================

APP_NAME="Suplemen Semarang Store"
APP_ENV=production
APP_KEY=
# debug WAJIB false: kalau true, halaman error menampilkan kredensial database
APP_DEBUG=false
APP_TIMEZONE=Asia/Jakarta
APP_URL=https://GANTI-domain-anda.com          # <-- GANTI, harus https

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID

# hanya catat error ke atas (jangan debug) supaya log tidak membengkak
LOG_CHANNEL=stack
LOG_STACK=single
LOG_LEVEL=error

# ---- Database -------------------------------------------------------
# Jangan pakai root. Buat user khusus:
#   CREATE DATABASE suplemen_semarang CHARACTER SET utf8mb4;
#   CREATE USER 'suplemen'@'localhost' IDENTIFIED BY '<password-kuat>';
#   GRANT ALL PRIVILEGES ON suplemen_semarang.* TO 'suplemen'@'localhost';
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=suplemen_semarang
DB_USERNAME=GANTI-user-db                       # <-- GANTI
DB_PASSWORD=GANTI-password-db                   # <-- GANTI

# ---- Sesi & cache ---------------------------------------------------
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# wajib true kalau sudah HTTPS — cookie sesi tidak ikut terkirim lewat http polos
SESSION_SECURE_COOKIE=true

# CACHE_STORE=database WAJIB dipertahankan: penguncian biaya rutin
# (BiayaRutinService) memakai tabel cache_locks, ikut terbuat saat migrate.
CACHE_STORE=database
QUEUE_CONNECTION=database
FILESYSTEM_DISK=local

BROADCAST_CONNECTION=log
MAIL_MAILER=log

# ---- Isian awal database (dipakai SEKALI saat setup) ----------------
# ProduksiSeeder membaca ini. Jangan disimpan permanen di .env —
# lebih aman diberikan langsung di perintah, lalu dihapus:
#   SEED_ADMIN_PASSWORD='...' php artisan db:seed --class=ProduksiSeeder --force
# SEED_BRANCH="Pusat"
# SEED_ADMIN_NAME="Administrator"
# SEED_ADMIN_USERNAME=admin
# SEED_ADMIN_EMAIL=admin@domain-anda.com
# SEED_ADMIN_PASSWORD=
